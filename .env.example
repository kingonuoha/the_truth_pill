# ============================================================
# TruthPill — web/ environment template
#
# ⚠️  THIS FILE CONTAINS NO SECRETS. Values are placeholders.
#     Key names are authoritative. Copy to `.env` and fill in.
#
#     NEVER commit a filled `.env` — it is gitignored.
#
#     `NEXT_PUBLIC_*` values are inlined into the client bundle at
#     build time. They are PUBLIC. Never put a secret behind one.
# ============================================================

# ---------- Next.js ----------
# Source: your own decision. Must have NO trailing slash — a trailing
# slash produced double-slash canonical URLs. See
# docs/archive/convex-era/track1-3-seo-analytics-bandwidth-fixes.md
NEXT_PUBLIC_SITE_URL=https://www.thetruthpill.org

# ---------- NextAuth ----------
# Source: `npx auth secret`
# NOTE: regenerating invalidates all existing sessions. Users must re-login.
AUTH_SECRET=

# ---------- Google OAuth ----------
# Source: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Nest API (api/) ----------
# The rewired frontend calls the Nest service through the BFF routes in
# `app/api/**`. Three of these four live on the *server* and must never be
# `NEXT_PUBLIC_*`.

# Server-only base URL. Read by `lib/api-token.ts` (`nestApiBaseUrl()`).
# No trailing slash. Defaults to http://localhost:3001 when unset.
NEST_API_URL=

# PUBLIC: the browser opens the SSE connection to the Nest service directly
# (`lib/sse.ts`), so this host must be reachable from the browser and must be
# the same host as NEST_API_URL.
NEXT_PUBLIC_NEST_API_URL=

# HS256 key for the ADR-017 API access token. `web/` mints, `api/` verifies.
# ⚠️ MUST be byte-identical to `api/`'s API_TOKEN_SECRET. A mismatch makes
#    every request 401. When unset, `lib/bff.ts` fails closed (503).
#    Server-only — never NEXT_PUBLIC_*.
API_TOKEN_SECRET=

# Timing-safe secret for `api/`'s `/internal/*` routes (AGENTS.md Hard Rule 6).
# Used by `auth.ts` `signIn` to store a Google user via
# `/api/v1/internal/users/store`. ⚠️ MUST equal `api/`'s INTERNAL_JOB_SECRET.
INTERNAL_JOB_SECRET=

# ⚠️ The token `iss` claim is `NEXT_PUBLIC_SITE_URL` with any trailing slash
#    stripped. `api/` verifies it against `API_TOKEN_ISSUER`, which defaults to
#    https://thetruthpill.org. If this site URL is the `www.` host, `api/` MUST
#    set API_TOKEN_ISSUER to exactly the same string or every token is rejected.


# ---------- Cloudinary (article + category + pillar images) ----------
# LIVE — `app/actions/upload-image.ts` uploads server-side.
# Source: Cloudinary console → Settings → Account
# NOTE: `CLOUDINARY_URL` is NOT read by `web/` — only the three keys below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Pexels (category + pillar imagery, Unsplash fallback) ----------
# LIVE — `app/actions/pexels.ts`.
# Source: https://www.pexels.com/api/
PEXELS_API_KEY=

# ============================================================
# ⚠️ LEGACY — NOT READ BY web/ AFTER THE PHASE 10 REWIRE.
#
# The frontend now talks to the Nest API, so nothing below this line is
# read by `web/` any more. Kept only so the pre-rewire build can still be
# rebuilt for a rollback. Delete the whole block at the Phase 12 cutover.
#
# Convex — deleted at Phase 12. Two deployments, so two sets of
# distinctly-named keys. The NEXT_PUBLIC_* pair is what a local build
# connects to. The CONVEX_PROD_* pair targets production — used for the
# Phase 02 data export, which must come from prod, not dev.
#
# Source: `npx convex env get` against each deployment, or the
#         Convex dashboard. Production export: `npx convex export --prod`
# ============================================================

# ---------- DEV / staging ----------
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# ---------- PROD ----------
# ⚠️ The deployment value embeds a credential after the `|`.
#    Never log it, never paste it into a report.
CONVEX_PROD_DEPLOYMENT=
CONVEX_PROD_URL=
CONVEX_PROD_SITE_URL=

# ---------- Email / SMTP (Nodemailer) ----------
# ⚠️ NOT read by `web/` after the rewire — mail now sends from `api/`
#    (`src/modules/emails/`). These belong on the API service, not Vercel.
# Source: your email provider's SMTP settings page
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ---------- Admin ----------
# ⚠️ NOT read by `web/` — this is an `api/` variable (DEV-003 CLI seed).
ADMIN_EMAIL=

